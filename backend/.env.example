# Template for backend/.env - COPY THIS, DO NOT PUT A REAL KEY IN THIS FILE.
#
#   cp backend/.env.example backend/.env
#   chmod 600 backend/.env
#   # edit backend/.env, then before running the server:
#   source backend/.env
#
# backend/.env is gitignored (root .gitignore line 50). THIS file is tracked,
# so it must only ever contain placeholders.
#
# Nothing auto-loads .env - there is no python-dotenv in this project. The
# `source` step above is what actually puts these into the environment, which
# is where agents/llm.py::HostedFreeTier reads them from at call time.

# Provider's OpenAI-compatible base URL (no trailing /chat/completions).
export TRIPWISE_LLM_BASE_URL=https://api.your-provider.example/openai/v1

# Model name as the provider spells it.
export TRIPWISE_LLM_MODEL=your-model-name

# The secret. Use a key with NO billing method attached, so the free tier
# hard-stops on rate limits instead of silently billing you - CLAUDE.md
# requires that overage be mechanically impossible, and code cannot verify
# a property of your provider account.
export TRIPWISE_LLM_API_KEY=paste-your-key-in-backend/.env-not-here

# Optional. Set to 0 if your provider rejects response_format=json_object.
# export TRIPWISE_LLM_JSON_MODE=1

# Optional. Per-request ceiling on provider calls, so a runaway loop cannot
# drain your quota. Default 25; the pipeline normally uses well under 10.
# export TRIPWISE_LLM_MAX_CALLS=25

# NEVER put the key in a NEXT_PUBLIC_* variable or anywhere under frontend/.
# Next.js inlines every NEXT_PUBLIC_* value into the JavaScript bundle it
# serves to the browser, which would publish your key to every visitor.
# The only frontend env vars are NEXT_PUBLIC_API_BASE_URL and
# NEXT_PUBLIC_API_MODE, and neither is a secret.
