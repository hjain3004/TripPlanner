# Copy outside the repository (it names private paths), chmod 600, and fill in.
# Offline by default: with TRIPWISE_RECURRING_LIVE unset or 0 nothing is fetched from Firecrawl.
TRIPWISE_RECURRING_DATA_DIR=/Users/you/tripwise-ingestion-data/recurring
TRIPWISE_RECURRING_POLICIES=/Users/you/tripwise-ingestion-data/recurring/inputs/policies.yaml
TRIPWISE_RECURRING_WATCHLIST=/Users/you/tripwise-ingestion-data/recurring/inputs/watchlist.yaml
TRIPWISE_RECURRING_WELCOME_TARGETS=/Users/you/tripwise-ingestion-data/recurring/inputs/welcome_targets.yaml
TRIPWISE_RECURRING_PUBLISHED_CATALOG=/Users/you/tripwise-ingestion-data/recurring/published
# A hard ceiling across every run, recorded once in the database; the owner's allowance.
TRIPWISE_RECURRING_LIFETIME_CREDITS=500
TRIPWISE_RECURRING_OPENING_CREDITS_USED=67
TRIPWISE_RECURRING_LIMIT=3
TRIPWISE_RECURRING_PER_RUN_CREDITS=12
TRIPWISE_RECURRING_PER_MONTH_CREDITS=60
TRIPWISE_RECURRING_MANIFEST=/Users/you/tripwise-ingestion-data/recurring/inputs/retained_manifest.json
# --- Live spending: leave commented until the owner decides. ---
# TRIPWISE_RECURRING_LIVE=1
# TRIPWISE_RECURRING_ROBOTS_FILE=/Users/you/tripwise-ingestion-data/recurring/inputs/axis_robots.txt
# TRIPWISE_RECURRING_RETAIN_DIR=/Users/you/tripwise-ingestion-data/recurring/retained-responses
# FIRECRAWL_API_KEY is taken from the environment of the scheduler; never put it in this file.
